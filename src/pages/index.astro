        <input type="text" id="consult-input" class="chat-input" placeholder="Ketik pesan Anda..." autocomplete="off" required />
        <button type="submit" class="chat-send">➤</button>
    </form>
</div>

<script>
    // FAQ
    document.querySelectorAll('.faq-q').forEach(q => {
        q.addEventListener('click', () => {
            const item = q.parentElement;
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        });
    });

    // SCROLL REVEAL
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((e, i) => {
            if (e.isIntersecting) {
                setTimeout(() => e.target.classList.add('visible'), i * 80);
                observer.unobserve(e.target);
            }
        });
    }, { threshold: 0.1 });
    reveals.forEach(el => observer.observe(el));

    // ─── SESSION IDs ───
    const sessionConsult = 'consult_' + Math.random().toString(36).substring(7);
    const sessionFree    = 'free_'    + Math.random().toString(36).substring(7);

    // ─── WEBHOOK URLs ───
    const WEBHOOK_CONSULT = 'https://n8n.aleshatour.my.id/webhook/website';
    const WEBHOOK_FREE    = 'https://n8n.aleshatour.my.id/webhook/free-tier'; // ← ganti URL ini

    // ─── HELPERS ───
    function addMsg(container, text, sender) {
        const div = document.createElement('div');
        div.className = 'msg ' + sender;
        div.textContent = text;
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
    }
    function showTyping(container, id) {
        const t = document.createElement('div');
        t.className = 'typing'; t.id = id;
        t.innerHTML = '<span></span><span></span><span></span>';
        container.appendChild(t);
        container.scrollTop = container.scrollHeight;
    }
    function hideTyping(id) { const t = document.getElementById(id); if (t) t.remove(); }

    async function sendMsg(text, sessionId, webhook, msgContainer, typingId) {
        showTyping(msgContainer, typingId);
        try {
            const res = await fetch(webhook, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text, chatId: sessionId })
            });
            const data = await res.json();
            hideTyping(typingId);
            addMsg(msgContainer, data.reply || data.output || data.message || 'Tim kami akan segera membalas!', 'bot');
        } catch {
            hideTyping(typingId);
            addMsg(msgContainer, 'Maaf, koneksi sedang bermasalah. Silakan coba kembali.', 'bot');
        }
    }

    // ─── CONSULT WINDOW ───
    const consultTrigger = document.getElementById('consult-trigger');
    const consultWindow  = document.getElementById('chat-window-consult');
    const consultMsgs    = document.getElementById('consult-messages');
    const consultForm    = document.getElementById('consult-form');
    const consultInput   = document.getElementById('consult-input');
    let consultGreeted   = false;

    consultTrigger.addEventListener('click', () => {
        // close free if open
        freeWindow.classList.remove('show');
        consultWindow.classList.toggle('show');
        if (consultWindow.classList.contains('show') && !consultGreeted) {
            consultGreeted = true;
            setTimeout(() => addMsg(consultMsgs, 'Halo! Saya AI Consultant SLi Project 🤖 Ceritakan kebutuhan bisnis Anda, saya siap membantu!', 'bot'), 500);
        }
    });
    document.getElementById('close-consult').addEventListener('click', () => consultWindow.classList.remove('show'));

    consultForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = consultInput.value.trim();
        if (!text) return;
        addMsg(consultMsgs, text, 'user');
        consultInput.value = '';
        await sendMsg(text, sessionConsult, WEBHOOK_CONSULT, consultMsgs, 'typing-consult');
    });

    // ─── FREE TIER WINDOW ───
    const freeTrigger = document.getElementById('free-tier-trigger');
    const freeWindow  = document.getElementById('chat-window-free');
    const freeMsgs    = document.getElementById('free-messages');
    const freeForm    = document.getElementById('free-form');
    const freeInput   = document.getElementById('free-input');
    let freeGreeted   = false;

    freeTrigger.addEventListener('click', () => {
        // close consult if open
        consultWindow.classList.remove('show');
        freeWindow.classList.toggle('show');
        if (freeWindow.classList.contains('show') && !freeGreeted) {
            freeGreeted = true;
            setTimeout(() => addMsg(freeMsgs, 'Halo! Selamat datang di AI Free Tier ✨ Coba tanya apa saja — layanan ini gratis untuk Anda!', 'bot'), 500);
        }
    });
    document.getElementById('close-free').addEventListener('click', () => freeWindow.classList.remove('show'));

    freeForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = freeInput.value.trim();
        if (!text) return;
        addMsg(freeMsgs, text, 'user');
        freeInput.value = '';
        await sendMsg(text, sessionFree, WEBHOOK_FREE, freeMsgs, 'typing-free');
    });
</script>
